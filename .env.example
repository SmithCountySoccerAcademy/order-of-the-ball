# Stripe (Live for real sales; Test for dry runs)
STRIPE_SECRET_KEY=sk_test_...

# One-time Price ID from Stripe Product catalog (recommended)
# Product: Order of the Ball · one-time payment
STRIPE_PRICE_ID=price_...

# Or set amount in cents if you prefer price_data (used only when STRIPE_PRICE_ID is empty)
# PRICE_CENTS=2000

# Public URL of the app (GitHub Pages) — no trailing slash
# Example: https://youruser.github.io/order-of-the-ball
PUBLIC_APP_URL=http://localhost:8787

# Secret used to sign lifetime unlock tokens (long random string)
UNLOCK_SECRET=change-me-to-a-long-random-string

# Secret for username+PIN session tokens (can match UNLOCK_SECRET)
# SESSION_SECRET=another-long-random-string
# Optional: how long sign-in lasts (days)
# SESSION_DAYS=60
# Optional: path for account + character JSON (use a Render disk for persistence)
# ACCOUNTS_PATH=/var/data/accounts.json

# Optional: comma-separated origins allowed to call the API (GitHub Pages URL)
# CORS_ORIGINS=https://youruser.github.io,http://localhost:8787

# Optional manual unlock codes (comma-separated) for beta families / gifts
# ACCESS_CODES=beta-family-1,gift-coach

PORT=8787

# Optional: where leaderboard JSON is stored (use a Render disk path for persistence)
# LEADERBOARD_PATH=/var/data/leaderboard.json
